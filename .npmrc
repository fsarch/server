# typeorm@1.1.1 declares an optional peer on better-sqlite3@^12.0.0, but this
# project pins better-sqlite3@^13.0.3 (needed elsewhere). That mismatch has
# always been part of the dependency graph - see the committed lockfile
# history - it just never got re-resolved under strict peer-dep checking
# until the lockfile needed regenerating for the MCP module's dependencies.
# Without this, `npm install`/`npm ci` fail with an ERESOLVE (or, via `npm
# ci`'s stricter lockfile-sync check, a confusing "missing hono" error).
legacy-peer-deps=true
