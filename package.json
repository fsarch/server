{
  "name": "@fsarch/server",
  "version": "0.1.5",
  "description": "A TypeScript-based HTTP server library with CLI support",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./pagination": {
      "import": "./dist/lib/pagination/index.js",
      "types": "./dist/lib/pagination/index.d.ts"
    },
    "./auth": {
      "import": "./dist/lib/auth/index.js",
      "types": "./dist/lib/auth/index.d.ts"
    },
    "./uac": {
      "import": "./dist/lib/uac/index.js",
      "types": "./dist/lib/uac/index.d.ts"
    },
    "./configuration": {
      "import": "./dist/lib/configuration/index.js",
      "types": "./dist/lib/configuration/index.d.ts"
    },
    "./deletion": {
      "import": "./dist/lib/deletion/index.js",
      "types": "./dist/lib/deletion/index.d.ts"
    },
    "./tracing": {
      "import": "./dist/lib/tracing/index.js",
      "types": "./dist/lib/tracing/index.d.ts"
    }
  },
  "bin": {
    "fsarch-server": "./dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "cli": "node bin/cli.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "server",
    "typescript",
    "cli",
    "nodejs",
    "fsarch"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "bin"
  ],
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.67.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@grpc/grpc-js": "^1.14.4",
    "better-sqlite3": "^12.11.1",
    "commander": "^15.0.0",
    "cron": "^4.4.0",
    "express": "^5.2.1",
    "joi": "^18.2.5",
    "jose": "^6.2.9",
    "js-yaml": "^5.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "serialize-error": "^13.0.1",
    "typeorm": "^1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fsarch/server.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
