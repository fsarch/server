{
  "name": "@fsarch/server",
  "version": "0.5.5",
  "description": "A TypeScript-based HTTP server library with CLI support",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./pagination": {
      "import": "./dist/lib/pagination/index.js",
      "types": "./dist/lib/pagination/index.d.ts"
    },
    "./auth": {
      "import": "./dist/lib/auth/index.js",
      "types": "./dist/lib/auth/index.d.ts"
    },
    "./uac": {
      "import": "./dist/lib/uac/index.js",
      "types": "./dist/lib/uac/index.d.ts"
    },
    "./configuration": {
      "import": "./dist/lib/configuration/index.js",
      "types": "./dist/lib/configuration/index.d.ts"
    },
    "./database": {
      "import": "./dist/lib/database/index.js",
      "types": "./dist/lib/database/index.d.ts"
    },
    "./deletion": {
      "import": "./dist/lib/deletion/index.js",
      "types": "./dist/lib/deletion/index.d.ts"
    },
    "./custom-resource": {
      "import": "./dist/lib/custom-resource/index.js",
      "types": "./dist/lib/custom-resource/index.d.ts"
    },
    "./tracing": {
      "import": "./dist/lib/tracing/index.js",
      "types": "./dist/lib/tracing/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/lib/mcp/index.js",
      "types": "./dist/lib/mcp/index.d.ts"
    },
    "./register": {
      "import": "./dist/lib/tracing/register.js",
      "types": "./dist/lib/tracing/register.d.ts"
    }
  },
  "bin": {
    "fsarch-server": "./dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "cli": "node bin/cli.js",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "check": "biome check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "server",
    "typescript",
    "cli",
    "nodejs",
    "fsarch"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "bin"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@nestjs/testing": "^12.2.0",
    "@nestjs/websockets": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@nestjs/cli": "^12.0.9",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/microservices": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.1",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.70.0",
    "@opentelemetry/instrumentation-pg": "^0.76.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@rekog/mcp-nest": "^2.0.8",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "cron": "^4.4.0",
    "express": "^5.3.0",
    "joi": "^18.3.0",
    "jose": "^6.2.13",
    "js-yaml": "^5.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "serialize-error": "^13.0.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fsarch/server.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
